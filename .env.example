# cp .env.example .env 후 값 채우기

# credential 암호화 키. 한 번 정하면 바꾸지 말 것 (바꾸면 저장된 credential 복호화 불가)
# 생성: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# 로컬(http) 접속용. 서버에 https로 올리면 true로 변경
N8N_SECURE_COOKIE=false


# Gmail SMTP (앱 비밀번호: https://myaccount.google.com/apppasswords)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# 알림 받을 주소 (비우면 GMAIL_ADDRESS로 발송)
ALERT_TO=

# 종목 시트 (https://docs.google.com/spreadsheets/d/<SHEET_ID>)
SHEET_ID=

# 한국투자증권 Open API (https://apiportal.koreainvestment.com)
# KIS_ENV: real(실전) | paper(모의투자)
KIS_ENV=
KIS_APP_KEY=
KIS_APP_SECRET=
